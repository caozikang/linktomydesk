<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 自己写 Main：以服务或 agent 方式启动时不能创建 WPF Application -->
    <StartupObject>RemoteControl.Server.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" Version="7.0.0" />
    <PackageReference Include="Sdcb.FFmpeg.runtime.windows-x64" Version="7.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\RemoteControl.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\FFmpegSetup.cs" Link="Media\FFmpegSetup.cs" />
    <Compile Include="..\Shared\UiKit.cs" Link="Ui\UiKit.cs" />
    <Page Include="..\Shared\Theme.xaml" Link="Theme.xaml" />
  </ItemGroup>

</Project>
