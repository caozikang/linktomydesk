    <Compile Include="..\..\Server\MainWindow.xaml.cs" Link="Linked\ServerMainWindow.cs" />
    <Compile Include="..\..\Server\RemoteServerWithRelay.cs" Link="Linked\RemoteServerWithRelay.cs" />
    <Compile Include="..\..\Server\ViewerSession.cs" Link="Linked\ViewerSession.cs" />
    <Compile Include="..\..\Server\ScreenCapture.cs" Link="Linked\ScreenCapture.cs" />
    <Compile Include="..\..\Server\H264Encoder.cs" Link="Linked\H264Encoder.cs" />
    <Compile Include="..\..\Server\InputSimulator.cs" Link="Linked\InputSimulator.cs" />
    <Compile Include="..\..\Server\FileTransferManager.cs" Link="Linked\FileTransferManager.cs" />
    <Compile Include="..\..\Client\MainWindow.xaml.cs" Link="Linked\ClientMainWindow.cs" />
